# ===== 视频提取工具配置 =====

# Obsidian 仓库路径（改成你自己的 Vault 目录）
OBSIDIAN_VAULT=C:\Users\TX\Desktop\jiahui-knowledge
# 保存到仓库下的子文件夹（不存在会自动创建）
OBSIDIAN_FOLDER=视频笔记

# LLM API（OpenAI 兼容接口）。任选一个填上 Key 即可：
#   示例1 DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   示例2 中转站:     LLM_BASE_URL=https://oneapi.basevec.com/v1  LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 抖音解析后端目录（可选，指向你的抖音解析实现）
# DOUYIN_BACKEND=D:\obsidian-content-capture-backend

# AI 生图（可选，用于「生成笔记图」的卡通封面；OpenAI 兼容 images/generations 接口）
# 例1 硅基流动(有免费 FLUX):  IMAGE_BASE_URL=https://api.siliconflow.cn/v1  IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# 例2 智谱 CogView:          IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4  IMAGE_MODEL=cogview-4-flash
# 例2 豆包火山 Ark(免费额度):   IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  IMAGE_MODEL=doubao-seedream-3-0-t2i
# 例3 智谱 CogView:          IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4  IMAGE_MODEL=cogview-4-flash
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.siliconflow.cn/v1
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
